{
  "mcpServers": {
    "meridian-usage-dev": {
      "command": "node",
      "args": [
        "${INSTALL_ROOT}/bundle/server.mjs"
      ],
      "env": {
        "MERIDIAN_ENV": "dev",
        "MERIDIAN_SERVICE_URL": "http://127.0.0.1:8081",
        "MERIDIAN_PERMISSIONS": "${INSTALL_ROOT}/dist/dev/permissions.json",
        "MERIDIAN_DIRECTORY": "${INSTALL_ROOT}/data/directory",
        "MERIDIAN_USER": "REPLACE_WITH_USER_EMAIL"
      }
    }
  }
}
