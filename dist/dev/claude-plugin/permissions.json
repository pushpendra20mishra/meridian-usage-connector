      "it-platform": true
    },
    "web-search": {
      "clinical-operations": true,
      "regulatory-affairs": true,
      "finance": true,
      "hr": true,
      "medical-writing": true,
      "it-platform": true
    },
    "code-execution": {
      "clinical-operations": true,
      "regulatory-affairs": true,
      "finance": true,
      "hr": true,
      "medical-writing": true,
      "it-platform": true
    }
  }
